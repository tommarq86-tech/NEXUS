<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#020712">
    <meta name="description" content="NEXUS - assistant intelligent">
    <link rel="icon" type="image/png" href="./nexus-icon-512.png">
    <link rel="manifest" href="./manifest.webmanifest">
    <link rel="stylesheet" href="./assets/index-CC51PXCK.css">

    <title>NEXUS Web</title>

    <style>
        /* =====================================================
           BOUTON PARLER À NEXUS
           ===================================================== */

        #nexus-console-launcher {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 99990;

            display: flex;
            align-items: center;
            gap: 10px;

            padding: 13px 20px;

            border: 1px solid rgba(0, 220, 255, 0.55);
            border-radius: 14px;

            background:
                linear-gradient(
                    135deg,
                    rgba(4, 20, 38, 0.97),
                    rgba(2, 10, 23, 0.97)
                );

            color: #7eefff;

            font-family: Arial, sans-serif;
            font-size: 14px;
            font-weight: 800;
            letter-spacing: 0.5px;

            cursor: pointer;

            box-shadow:
                0 0 22px rgba(0, 220, 255, 0.18),
                inset 0 0 15px rgba(0, 220, 255, 0.04);

            backdrop-filter: blur(12px);

            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease,
                background 0.2s ease;
        }

        #nexus-console-launcher:hover {
            transform: translateY(-2px);

            background:
                linear-gradient(
                    135deg,
                    rgba(6, 31, 53, 0.99),
                    rgba(2, 13, 29, 0.99)
                );

            box-shadow:
                0 0 32px rgba(0, 220, 255, 0.35),
                inset 0 0 18px rgba(0, 220, 255, 0.07);
        }

        #nexus-console-launcher:active {
            transform: translateY(0);
        }

        /* =====================================================
           FENÊTRE DE L'ASSISTANT NUMÉRIQUE
           ===================================================== */

        #nexus-console-overlay {
            display: none;

            position: fixed;
            inset: 0;

            z-index: 99999;

            background: #020712;
        }

        #nexus-console-overlay.active {
            display: block;
        }

        #nexus-console-frame {
            width: 100%;
            height: 100%;

            border: 0;

            display: block;

            background: #020712;
        }

        /* =====================================================
           BOUTON FERMER
           ===================================================== */

        #nexus-console-close {
            position: absolute;

            top: 16px;
            right: 20px;

            z-index: 100001;

            width: 44px;
            height: 44px;

            border: 1px solid rgba(255,255,255,0.25);
            border-radius: 50%;

            background: rgba(2, 7, 18, 0.90);

            color: white;

            font-family: Arial, sans-serif;
            font-size: 25px;
            line-height: 1;

            cursor: pointer;

            box-shadow: 0 0 20px rgba(0,0,0,0.4);

            backdrop-filter: blur(10px);

            transition:
                background 0.2s ease,
                transform 0.2s ease;
        }

        #nexus-console-close:hover {
            background: rgba(20, 35, 52, 0.98);
            transform: scale(1.06);
        }

        /* =====================================================
           PETIT INDICATEUR
           ===================================================== */

        #nexus-console-status {
            position: fixed;

            right: 24px;
            bottom: 78px;

            z-index: 99989;

            display: none;

            padding: 6px 10px;

            border-radius: 8px;

            background: rgba(2, 7, 18, 0.85);

            color: rgba(126,239,255,0.75);

            font-family: Arial, sans-serif;
            font-size: 10px;

            pointer-events: none;
        }

        #nexus-console-overlay.active + #nexus-console-status {
            display: none;
        }

        @media (max-width: 700px) {
            #nexus-console-launcher {
                right: 14px;
                bottom: 14px;

                padding: 12px 16px;

                font-size: 13px;
            }
        }
    </style>
</head>

<body>

    <!-- =====================================================
         VRAI NEXUS WEB REACT
         ===================================================== -->

    <div id="root"></div>


    <!-- =====================================================
         BOUTON PARLER À NEXUS
         ===================================================== -->

    <button
        id="nexus-console-launcher"
        type="button"
        aria-label="Parler à NEXUS"
    >
        🎙️ PARLER À NEXUS
    </button>


    <!-- =====================================================
         VRAIE INTERFACE ASSISTANT NUMÉRIQUE
         app.html = même interface que /console
         ===================================================== -->

    <div
        id="nexus-console-overlay"
        aria-hidden="true"
    >

        <button
            id="nexus-console-close"
            type="button"
            aria-label="Fermer l'assistant NEXUS"
        >
            ×
        </button>

        <iframe
            id="nexus-console-frame"
            src="../../app.html"
            title="Nexus Assistant Numérique PC Finder"
            allow="microphone; autoplay"
        ></iframe>

    </div>


    <div id="nexus-console-status">
        ASSISTANT NUMÉRIQUE NEXUS
    </div>


    <!-- =====================================================
         LOGIQUE DE FUSION
         ===================================================== -->

    <script>
    (function () {

        function initNexusFusion() {

            var launcher =
                document.getElementById("nexus-console-launcher");

            var overlay =
                document.getElementById("nexus-console-overlay");

            var closeButton =
                document.getElementById("nexus-console-close");

            var frame =
                document.getElementById("nexus-console-frame");


            if (!launcher || !overlay || !closeButton || !frame) {
                return;
            }


            function openAssistant() {

                overlay.classList.add("active");

                overlay.setAttribute(
                    "aria-hidden",
                    "false"
                );

                document.body.style.overflow = "hidden";

            }


            function closeAssistant() {

                overlay.classList.remove("active");

                overlay.setAttribute(
                    "aria-hidden",
                    "true"
                );

                document.body.style.overflow = "";

            }


            launcher.addEventListener(
                "click",
                openAssistant
            );


            closeButton.addEventListener(
                "click",
                closeAssistant
            );


            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {
                        closeAssistant();
                    }

                }
            );


            /*
             * Si l'utilisateur recharge la page de l'assistant
             * dans l'iframe, on garde l'interface réelle.
             */
            frame.addEventListener(
                "load",
                function () {

                    try {

                        frame.contentWindow.postMessage(
                            {
                                type: "NEXUS_WEB_OPENED"
                            },
                            "*"
                        );

                    } catch (error) {
                        // Rien à faire : l'iframe fonctionne quand même.
                    }

                }
            );

        }


        if (document.readyState === "loading") {

            document.addEventListener(
                "DOMContentLoaded",
                initNexusFusion
            );

        } else {

            initNexusFusion();

        }

    })();
    </script>


    <!-- =====================================================
         VRAI BUNDLE REACT NEXUS WEB
         ===================================================== -->

    <script
        type="module"
        src="./assets/index-C4bZbmBa.js">
    </script>

</body>
</html>
