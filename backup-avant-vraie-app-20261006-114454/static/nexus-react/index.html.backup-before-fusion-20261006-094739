    color: white;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    font-size: 20px;
    cursor: pointer;
}
</style>

<button id="nexus-pcfinder-launcher" type="button">
    🖥️ PC FINDER
</button>

<div id="nexus-pcfinder-overlay">
    <button id="nexus-pcfinder-close" type="button" aria-label="Fermer">
        ×
    </button>

    <iframe
        id="nexus-pcfinder-frame"
        src="../../app.html"
        title="Nexus Assistant Numérique PC Finder"
        allow="microphone">
    </iframe>
</div>

<script>
(function () {
    function initNexusPcFinder() {
        var launcher = document.getElementById("nexus-pcfinder-launcher");
        var overlay = document.getElementById("nexus-pcfinder-overlay");
        var closeButton = document.getElementById("nexus-pcfinder-close");

        if (!launcher || !overlay || !closeButton) {
            return;
        }

        launcher.addEventListener("click", function () {
            overlay.classList.add("active");
            document.body.style.overflow = "hidden";
        });

        closeButton.addEventListener("click", function () {
            overlay.classList.remove("active");
            document.body.style.overflow = "";
        });

        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape") {
                overlay.classList.remove("active");
                document.body.style.overflow = "";
            }
        });
    }

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", initNexusPcFinder);
    } else {
        initNexusPcFinder();
    }
})();
</script></body>
</html>

