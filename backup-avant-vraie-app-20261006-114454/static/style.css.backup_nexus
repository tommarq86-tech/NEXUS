* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
    -webkit-tap-highlight-color: transparent;
}

body {
    font-family: Arial, sans-serif;
    background: #0b1020;
    color: white;
    line-height: 1.6;
    touch-action: manipulation;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
}

.header {
    min-height: 75px;
    padding: 15px 8%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #20283d;
    background: #0b1020;
}

.logo {
    font-size: 25px;
    font-weight: 800;
    letter-spacing: 3px;
}

nav {
    display: flex;
    gap: 15px;
}

nav a {
    color: #cbd5e1;
    text-decoration: none;
    padding: 12px 16px;
    border-radius: 10px;
}

nav a:active {
    background: #182238;
}

.hero {
    min-height: 600px;
    display: flex;
    align-items: center;
    padding: 80px 8%;
}

.hero-content {
    max-width: 700px;
}

.surtitle {
    color: #7dd3fc;
    font-weight: bold;
    letter-spacing: 3px;
    margin-bottom: 20px;
}

h1 {
    font-size: 70px;
    line-height: 1.05;
    margin-bottom: 25px;
}

h1 span {
    color: #60a5fa;
}

.description {
    color: #b6c0d4;
    font-size: 19px;
    max-width: 600px;
    margin-bottom: 35px;
}

.buttons {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
}

.button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 13px 24px;
    border-radius: 10px;
    font-weight: bold;
    text-decoration: none;
    cursor: pointer;
    border: none;
    user-select: none;
}

.button:active {
    transform: scale(0.97);
}

.primary {
    background: #2563eb;
    color: white;
}

.secondary {
    background: #182238;
    color: white;
    border: 1px solid #33415c;
}

.pricing {
    padding: 90px 8%;
    background: #080d1a;
    text-align: center;
}

h2 {
    font-size: 38px;
    margin-bottom: 15px;
}

.section-description {
    color: #9ca8bc;
    margin-bottom: 45px;
}

.plans {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 25px;
    max-width: 1100px;
    margin: auto;
}

.plan {
    position: relative;
    background: #11182a;
    border: 1px solid #26324a;
    border-radius: 18px;
    padding: 35px 25px;
    text-align: left;
}

.plan h3 {
    font-size: 25px;
    margin-bottom: 15px;
}

.price {
    font-size: 20px;
    font-weight: bold;
    margin-bottom: 25px;
}

.plan ul {
    list-style: none;
    color: #b9c3d5;
    margin-bottom: 30px;
}

.plan li {
    margin-bottom: 10px;
}

.badge {
    position: absolute;
    top: -13px;
    right: 20px;
    background: #2563eb;
    padding: 5px 12px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: bold;
}

.login {
    text-align: center;
    padding: 90px 20px;
}

.login p {
    color: #aab4c7;
    margin: 15px 0 30px;
}

footer {
    padding: 30px;
    text-align: center;
    color: #69758b;
    border-top: 1px solid #20283d;
}

@media (max-width: 800px) {

    .header {
        padding: 15px 5%;
    }

    nav {
        gap: 4px;
    }

    nav a {
        padding: 10px 8px;
        font-size: 14px;
    }

    h1 {
        font-size: 48px;
    }

    .hero {
        min-height: 500px;
        padding: 60px 5%;
    }

    .plans {
        grid-template-columns: 1fr;
    }

    .button {
        width: 100%;
    }

    .buttons {
        width: 100%;
    }
}
